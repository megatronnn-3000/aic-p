# Frontend build-time settings (Vercel → Project → Settings → Environment Variables).
# Base URL of the Flask API, without a trailing slash. Leave empty (the default):
# requests go to /api on the same origin, which Vercel routes to the backend
# service in production and Vite proxies to localhost:5000 in development.
# Set it only if the API is hosted somewhere else (e.g. a separate Render service).
VITE_API_URL=

# Development only: where the Vite dev server proxies /api (default http://127.0.0.1:5000)
VITE_DEV_API_TARGET=
