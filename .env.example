# Frontend build-time settings (Vercel → Project → Settings → Environment Variables).
# Base URL of the Flask API, without a trailing slash.
# Default in production builds: https://pre-incubation-backend.onrender.com
# Default in development: "" (requests go to /api and Vite proxies them to localhost:5000)
VITE_API_URL=

# Development only: where the Vite dev server proxies /api (default http://127.0.0.1:5000)
VITE_DEV_API_TARGET=
