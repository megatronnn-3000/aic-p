# Copy to backend/.env for local development. On Render, set these in the
# service's Environment tab instead. Never commit real values.

# --- Required in production -------------------------------------------------
# Long random string used to sign staff sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Staff sign-in. Sign-in is disabled until ADMIN_PASSWORD (or ADMIN_PASSWORD_HASH,
# a werkzeug hash) is set.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Database ------------------------------------------------------------------
# Leave empty for a local SQLite file (backend/startups.db).
# Production: a persistent Postgres URL (Neon or Supabase free tiers persist;
# Render's free Postgres is deleted after 30 days).
DATABASE_URL=

# --- File storage --------------------------------------------------------------
# local    -> UPLOAD_DIR on disk (default with SQLite; NOT durable on Render free tier)
# database -> stored inside Postgres (default when DATABASE_URL is Postgres)
# s3       -> S3-compatible bucket (Cloudflare R2, AWS S3, Backblaze B2, Supabase Storage)
STORAGE_BACKEND=
UPLOAD_DIR=
S3_BUCKET=
S3_REGION=            # "auto" for Cloudflare R2, e.g. "ap-south-1" for AWS
S3_ENDPOINT_URL=      # e.g. https://<account-id>.r2.cloudflarestorage.com (empty for AWS)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=aic-portal/

# --- Email -----------------------------------------------------------------------
# brevo | resend | smtp | console | (empty = disabled)
# Render's free tier blocks SMTP ports, so use brevo or resend there.
MAIL_PROVIDER=
MAIL_FROM=            # verified sender address
MAIL_FROM_NAME=AIC MUJ Incubation Foundation
ADMIN_NOTIFY_EMAIL=   # where new-application / enquiry alerts go
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Web --------------------------------------------------------------------------
# Comma-separated origins allowed to call the API (the Vercel frontend).
CORS_ORIGINS=http://localhost:5173,https://pre-incubation-ui.vercel.app
# Regex for preview deployments.
CORS_ORIGIN_REGEX=https://pre-incubation[a-z0-9-]*\.vercel\.app

# --- Limits (optional) ------------------------------------------------------------
MAX_FILE_MB=20
MAX_REQUEST_MB=80
TOKEN_TTL_HOURS=12
PUBLIC_SUBMISSIONS_PER_HOUR=100
LOGIN_ATTEMPTS_PER_15_MIN=8
